# Backend base URL override (defaults to the Vite "/api" dev proxy).
# VITE_API_BASE_URL=http://localhost:4000

# OAuth — client-side identifiers for the sign-in flow.
# Google Identity Services client id.
# VITE_GOOGLE_CLIENT_ID=
# Facebook App id (for the Facebook JS SDK).
# VITE_FACEBOOK_APP_ID=

# Azure Cognitive Services Speech — OPTIONAL.
# When both are set, react-speech-recognition uses the Azure polyfill for
# consistent cross-platform STT. If unset, the app falls back to the browser's
# native Web Speech API (Chromium only).
# VITE_AZURE_SPEECH_KEY=
# VITE_AZURE_SPEECH_REGION=
