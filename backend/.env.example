# Server
PORT=4000

# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=expense_tracker

# LLM provider for voice-entry parsing.
# Provider is selected once at startup: if GROQ_API_KEY is set and non-empty,
# Groq is used; otherwise the app falls back to Gemini.

# Groq (preferred when set) — OpenAI-compatible API
GROQ_API_KEY=
# Optional: override the model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API (fallback when GROQ_API_KEY is unset)
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
